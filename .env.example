# Vercel / production에서 사용할 단일 관리자 계정
ADMIN_USERNAME=finance
ADMIN_PASSWORD=change-this-to-a-long-password

# 세션 쿠키 서명용. 운영에서는 32자 이상의 충분히 긴 랜덤 문자열 사용.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# 참고: `npm run dev`에서는 위 값이 없어도 아래 로컬 테스트 계정이 자동 활성화된다.
# ID: finance
# PW: finance1234
# production에서는 이 fallback이 비활성화된다.

# BAND API 발급 후 사용
BAND_ACCESS_TOKEN=
BAND_KEY=
